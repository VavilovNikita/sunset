# Copy to .env and fill in real values. .env must never be committed.

# This app now owns the Postgres schema via Flyway migrations (previously owned by
# the Next.js app's Prisma migrations - see db/migration/V1__baseline.sql). The
# correct host depends on WHERE that Postgres actually runs relative to this
# container - pick one:
#
#   Scenario A - Postgres runs directly on the VPS host, or as a container
#   that publishes its port to the host (e.g. "5432:5432"):
#     DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/sunsetbeach
#     (works because docker-compose.yml maps host.docker.internal to the
#     host gateway via extra_hosts - no other changes needed)
#
#   Scenario B - Postgres runs as a container in the sunset-beach compose
#   project with NO published host port (the common case when only the
#   frontend's port is exposed). host.docker.internal will NOT reach it -
#   you must join that project's docker network and address the DB by its
#   container name instead:
#     DATABASE_URL=jdbc:postgresql://sunset-beach-db-1:5432/sunsetbeach
#     (replace sunset-beach-db-1 with the real container name from `docker ps`,
#     and see docker-compose.yml for the matching `networks:` block you need
#     to uncomment there)
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/sunsetbeach
DATABASE_USER=sunsetbeach
DATABASE_PASSWORD=change-me

# Optional: how long (ms) to wait for a DB connection before failing startup.
# Defaults to 5000 (see application.properties) so a wrong host/port/password
# above surfaces a clear connection error quickly instead of a slow, generic
# Hibernate dialect-detection failure. Raise this if the DB is known to be
# slow to accept connections (e.g. under load).
# DB_CONNECTION_TIMEOUT_MS=5000

# HMAC-SHA256 signing key for the JWTs this app issues from POST /auth/login and verifies
# on every subsequent request (Authorization: Bearer <token>). At least 32 bytes; generate
# with e.g. `openssl rand -base64 32`. No fallback default - the app fails to start without it.
JWT_SECRET=

# Optional: how many days an issued JWT stays valid before the client must log in again.
# Defaults to 7 (see application.properties).
# JWT_TTL_DAYS=7

# HMAC-SHA256 signing key for GuestAccount JWTs (POST /guest-auth/verify|login) - a completely
# separate secret from JWT_SECRET above, never the same value. This is the safety boundary
# between the staff and guest identity systems: a guest token can never verify against
# JWT_SECRET or vice versa. At least 32 bytes; generate the same way as JWT_SECRET, with a
# different result. No fallback default - the app fails to start without it.
GUEST_JWT_SECRET=

# Optional: how many days an issued guest JWT stays valid. Defaults to 30 (see
# application.properties) - longer than staff's 7, since this is a guest's own device, not a
# shared terminal.
# GUEST_JWT_TTL_DAYS=30

# Optional: how many hours a guest account's email verification link stays valid. Defaults to
# 24 (see application.properties).
# GUEST_ACCOUNT_VERIFICATION_TTL_HOURS=24

# Optional: transactional email (booking confirmations, etc).
RESEND_API_KEY=
EMAIL_FROM=The Sunset Beach Resort & Spa <bookings@sunsetbeach.example>

# Public site URL, embedded in outgoing emails as the base for links.
NEXTAUTH_URL=https://sunsetbeach.example

# Comma-separated origins allowed to call this API cross-origin with credentials
# (the next-auth.session-token cookie). Must list the exact frontend origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JVM tuning knob consumed by the container entrypoint (see docker-compose.yml).
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# Gym equipment (fans, air conditioners) through the Tuya cloud API. Leave empty to switch the
# integration off - the Gym page then says it is not configured. Take the three values from
# iot.tuya.com -> Cloud -> Development -> project "sunset" -> Overview -> Authorization Key:
#   TUYA_CLIENT_ID     = Access ID / Client ID
#   TUYA_CLIENT_SECRET = Access Secret / Client Secret
#   TUYA_API_BASE      = the endpoint of the project's data centre (the Singapore one is
#                        https://openapi-sg.iotbing.com)
# The Trial Edition's IoT Core subscription must be extended by hand every few months (see DEPLOY.md).
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_API_BASE=
# Optional: seconds a relay's state read is reused (default 30) and the monthly call quota shown
# next to the counter in the Gym settings (default 26000; informational only).
# TUYA_STATE_CACHE_SECONDS=30
# TUYA_MONTHLY_QUOTA_HINT=26000

# WLED lighting controllers on the hotel LAN. REQUIRED for the Lighting pages to work: the network(s) the
# controllers are on, as comma-separated CIDRs (your hotel LAN, e.g. a /24). Empty = lighting is off and the
# pages say it is not configured. Without it any private address would be accepted - including the database
# and the other containers on the compose network. A malformed value stops the backend from starting.
LIGHTING_ALLOWED_CIDRS=
# Optional (defaults in brackets): LIGHTING_CONNECT_TIMEOUT_MS [2000], LIGHTING_REQUEST_TIMEOUT_MS [2500],
# LIGHTING_STATE_CACHE_SECONDS [10]

# Telegram bot for staff notifications (late, absence, terminal, room blocks). Token from @BotFather. Empty = Telegram
# is off: nothing is polled or sent and the admin pages say it is not configured. Never printed or logged.
TELEGRAM_BOT_TOKEN=
# Optional (defaults in brackets): TELEGRAM_POLL_INTERVAL_MS [200], TELEGRAM_LONG_POLL_SECONDS [25],
# TELEGRAM_BACKOFF_BASE_SECONDS [3], TELEGRAM_BACKOFF_MAX_SECONDS [60], SCHEDULING_POOL_SIZE [8],
# NOTIFICATIONS_SCAN_INTERVAL_MS [60000], NOTIFICATIONS_DELIVERY_INTERVAL_MS [5000], NOTIFICATIONS_MAX_ATTEMPTS [5]
