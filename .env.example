# Copy to .env and fill in real values. .env must never be committed.

# Postgres schema is owned by the Next.js app's Prisma migrations - this
# points at that same database. The correct host depends on WHERE that
# Postgres actually runs relative to this container - pick one:
#
#   Scenario A - Postgres runs directly on the VPS host, or as a container
#   that publishes its port to the host (e.g. "5432:5432"):
#     DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/sunsetbeach
#     (works because docker-compose.yml maps host.docker.internal to the
#     host gateway via extra_hosts - no other changes needed)
#
#   Scenario B - Postgres runs as a container in the sunset-beach compose
#   project with NO published host port (the common case when only the
#   frontend's port is exposed). host.docker.internal will NOT reach it -
#   you must join that project's docker network and address the DB by its
#   container name instead:
#     DATABASE_URL=jdbc:postgresql://sunset-beach-db-1:5432/sunsetbeach
#     (replace sunset-beach-db-1 with the real container name from `docker ps`,
#     and see docker-compose.yml for the matching `networks:` block you need
#     to uncomment there)
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/sunsetbeach
DATABASE_USER=sunsetbeach
DATABASE_PASSWORD=change-me

# Optional: how long (ms) to wait for a DB connection before failing startup.
# Defaults to 5000 (see application.properties) so a wrong host/port/password
# above surfaces a clear connection error quickly instead of a slow, generic
# Hibernate dialect-detection failure. Raise this if the DB is known to be
# slow to accept connections (e.g. under load).
# DB_CONNECTION_TIMEOUT_MS=5000

# Must be byte-for-byte the same secret the Next.js app uses to encrypt the
# next-auth.session-token cookie (NextAuth v4, JWE dir/A256GCM).
NEXTAUTH_SECRET=

# Optional: transactional email (booking confirmations, etc).
RESEND_API_KEY=
EMAIL_FROM=The Sunset Beach Resort & Spa <bookings@sunsetbeach.example>

# Public site URL, embedded in outgoing emails as the base for links.
NEXTAUTH_URL=https://sunsetbeach.example

# Comma-separated origins allowed to call this API cross-origin with credentials
# (the next-auth.session-token cookie). Must list the exact frontend origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JVM tuning knob consumed by the container entrypoint (see docker-compose.yml).
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
