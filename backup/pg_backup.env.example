# Copy this file to /etc/sunsetbeach-backup.env on the server (chmod 600 - it
# can end up holding a GPG recipient and, indirectly, control over where
# guest data gets copied) and fill in the real values. Loaded by
# systemd/pg-backup.service.

# Find the real container name with: docker ps --format '{{.Names}}'
PG_CONTAINER=sunset-beach-db-1
PG_DB=sunsetbeach
PG_USER=sunsetbeach

# Tier 1 - REQUIRED: a path on a *different disk* than the one Postgres's
# own data directory/volume lives on. An external USB drive mounted here is
# the minimum viable version of this whole setup - see RESTORE_RUNBOOK.md
# section "Where backups live" for the reasoning and the cost/tradeoff of
# each option.
BACKUP_DIR=/mnt/backup-drive/sunsetbeach

# Tier 2a - optional: a mounted NAS share, second external drive kept
# elsewhere in the building, etc. Leave blank to skip.
OFFSITE_DIR=

# Tier 2b - optional but recommended: an rclone remote for offsite/cloud
# storage, protecting against the server (and anything plugged into it)
# being lost entirely - fire, theft, flood. Set up once with `rclone config`
# (not managed by this script). Example: RCLONE_REMOTE=b2:sunsetbeach-backups
RCLONE_REMOTE=

# If RCLONE_REMOTE is set, strongly recommended: a GPG recipient (key ID or
# email) whose PUBLIC key is imported on this server, so the copy sent to the
# cloud is encrypted before it leaves the building. The matching PRIVATE key
# must NOT live on this server - keep it with the owner/manager, offline
# (e.g. on a USB stick in a drawer, or a password manager), so that someone
# who compromises the server still can't decrypt the offsite backups.
GPG_RECIPIENT=

# Recommended: free at healthchecks.io (or any similar dead-man's-switch
# service). Create a check there with a 26-27 hour expected period, and it
# will email/SMS you if a day passes with no ping - which is how you find
# out backups stopped without ever looking at the server.
HEALTHCHECK_URL=

# Retention (days/weeks/months of generations to keep - see RESTORE_RUNBOOK.md
# for the reasoning). Defaults are usually fine as-is.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# ---- Uploads volume backup (uploads_backup.sh) - same file, same OFFSITE_DIR / RCLONE_REMOTE /
# GPG_RECIPIENT / KEEP_* as above ----
# Name of the Docker volume holding /app/uploads: `docker volume ls | grep uploads`
# ("<compose project>_uploads", sunset_uploads for the checkout in ~/sunset/sunset).
UPLOADS_VOLUME=sunset_uploads
# Where the uploads_YYYYMMDD_HHMMSS.tgz archives go. Needs no separate disk the way the database
# dump does (photos can be uploaded again; the database cannot be re-entered), but a separate
# disk is still better.
UPLOADS_BACKUP_DIR=/var/backups/sunsetbeach
# Any image that has tar; the backend image is already on the host.
UPLOADS_TAR_IMAGE=sunset-backend:latest
# Its own healthchecks.io check (26-27 hour period), separate from HEALTHCHECK_URL. Optional.
UPLOADS_HEALTHCHECK_URL=
