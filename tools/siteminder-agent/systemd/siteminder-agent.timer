[Unit]
Description=Run the SiteMinder reservation import daily

[Timer]
# 02:15 Asia/Bangkok - well clear of reception hours and of pg-backup (03:30).
OnCalendar=*-*-* 02:15:00 Asia/Bangkok
# Run on boot if the server was off at 02:15.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
