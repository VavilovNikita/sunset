# Copy to .env on the server, chmod 600, fill in. Never commit .env.

# --- SiteMinder extranet ---
SM_LOGIN_URL=https://extranet.siteminder.com/login
SM_USERNAME=
SM_PASSWORD=
# Page showing the Reservations list. Open it by hand once and paste its URL.
SM_RESERVATIONS_URL=
# Optional overrides when the defaults in src/config.js don't match the page:
# SM_TABLE_SELECTOR=table
# SM_NEXT_SELECTOR=
# SM_MAX_PAGES=50
# UTC offset SiteMinder's "Booked on" times are shown in.
SM_TZ_OFFSET=+07:00

# --- sunset backend (same host) ---
SUNSET_IMPORT_URL=http://127.0.0.1:8080/api/integrations/siteminder/reservations
# Same value as SITEMINDER_INTEGRATION_KEY on the backend.
SUNSET_INTEGRATION_KEY=

# --- Local files ---
STATE_DIR=./state
LOG_FILE=./logs/agent.log
