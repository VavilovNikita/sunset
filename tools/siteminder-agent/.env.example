# Copy to .env on the server, chmod 600, fill in. Never commit .env.

# --- SiteMinder extranet ---
SM_LOGIN_URL=https://authx.siteminder.com/login
SM_USERNAME=
SM_PASSWORD=
# The Reservations search URL is built on every run with fresh dates (src/url.js). Do NOT put a
# dated URL here; the old SM_RESERVATIONS_URL setting is ignored.
# Window = modified in the last SM_LOOKBACK_DAYS days (default 3) up to tomorrow, hotel time.
# SM_LOOKBACK_DAYS=3
# SM_PAGE_SIZE=10
# SM_PROPERTY_ID=455c0edf-8114-11e5-8827-02b1347ffa5b
# SM_HOTEL_TZ=Asia/Bangkok
# Extra query params copied from SiteMinder's own URL, e.g. sortBy=...&sortOrder=...
# SM_EXTRA_QUERY=
# Optional overrides when the defaults in src/config.js don't match the page:
# SM_TABLE_SELECTOR=table
# SM_MAX_PAGES=50
# UTC offset SiteMinder's "Booked on" times are shown in.
SM_TZ_OFFSET=+07:00

# --- sunset backend (same host) ---
SUNSET_IMPORT_URL=http://127.0.0.1:8080/api/integrations/siteminder/reservations
# Same value as SITEMINDER_INTEGRATION_KEY on the backend.
SUNSET_INTEGRATION_KEY=

# --- Local files ---
STATE_DIR=./state
LOG_FILE=./logs/agent.log
# Numeric dates (e.g. 08.30.2026) are read month-first unless the table itself proves otherwise (a day above 12).
# Only matters when every date in a run is ambiguous; set dmy if SiteMinder turns out to be day-first.
# SM_DATE_ORDER=mdy
